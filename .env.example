# Copy to apps/api/.env  (cp .env.example apps/api/.env)

NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Postgres from docker-compose (host port 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql://deskai:deskai@localhost:5433/deskai
# Used by e2e tests only
TEST_DATABASE_URL=postgresql://deskai:deskai@localhost:5433/deskai_test

# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# AI. Leave OPENAI_API_KEY empty to use the built-in mock (deterministic keyword rules, no network).
OPENAI_API_KEY=
# Default: gpt-4o-mini
OPENAI_MODEL=
# Timeout per attempt; triage and drafts make at most two attempts
AI_TIMEOUT_MS=10000
