{
  "name": "@deskai/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, enums and API contracts shared by the DeskAI api and web apps",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo \"no tests in shared\""
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
